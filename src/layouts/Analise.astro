---
import Base from './Base.astro';
import { dataBR, type AnaliseMeta } from '../lib/analises';

interface Props {
  meta: AnaliseMeta;
  /** Seções para o índice no topo: [id, rótulo]. */
  secoes?: [string, string][];
}
const { meta, secoes = [] } = Astro.props;
---
<Base title={`${meta.titulo} · Setos`} description={`Setos Consultoria · ${meta.resumo} Análise feita em ${dataBR(meta.data)}.`}>
  <div class="hero">
    <div class="wrap">
      <span class="eyebrow">Análise · {meta.categoria}</span>
      <h1>{meta.titulo}</h1>
      <p set:html={meta.resumo} />
      <div class="meta">
        <span class="pill">Data da análise: <b>{dataBR(meta.data)}</b></span>
        {meta.destaques?.map((d) => <span class="pill">{d.label}: <b>{d.valor}</b></span>)}
        <span class="pill">Preparado por: <b>Setos Consultoria</b></span>
        {meta.uso && <span class="pill">Uso: <b>{meta.uso}</b></span>}
      </div>
      {secoes.length > 0 && (
        <nav class="toc" aria-label="Seções">
          {secoes.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      )}
    </div>
  </div>
  <main class="wrap">
    <slot />
  </main>
</Base>
